# ==== HavenHunt — Agentic Real-Estate Organisation ====
# Copy this file to .env and fill in your real values.
# .env is git-ignored and must NEVER be committed.

# OpenAI (required)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Telegram (required for the bot)
# Get from @BotFather -> /newbot -> copy the token exactly.
# Format: 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=haven_hunt_bot

# Live listings API (optional — enables real data; skip for built-in demo data)
# SimplyRETS free trial: https://www.simplyrets.com
SIMPLYRETS_USERNAME=
SIMPLYRETS_PASSWORD=

# Cloudflare Worker relay for the web chat (optional — see worker/worker.js)
# Example: https://haven-hunt-relay.your-subdomain.workers.dev
WEB_RELAY_URL=

# Public site URL (GitHub Pages)
SITE_URL=https://YOUR_USERNAME.github.io/haven-hunt/
