# ==== HavenHunt — Agentic Real-Estate Organisation (Ireland) ====
# Copy this file to .env and fill in your real values.
# .env is git-ignored and must NEVER be committed.

# OpenAI (required)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Telegram (required for the bot)
# Get from @BotFather -> /newbot -> copy the token exactly.
# Format: 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=haven_hunt_bot

# Property Price Register (PPR) — live Irish sales data
# Official register: https://www.propertypriceregister.ie (no official API)
# Community JSON API used for live fetches (default below).
PPR_API_URL=https://priceregister.civictech.ie/api/v1/residential/sales
# "auto" | "on" | "off" — whether to enable the live PPR fetch
PPR_FETCH=auto
# How many live records to fetch per refresh (default 1500)
PPR_FETCH_COUNT=1500

# Google Maps API (optional — geocoding + map links)
# Without a key the product falls back to OpenStreetMap Nominatim.
GOOGLE_MAPS_API_KEY=

# Cloudflare Worker relay for the web chat (optional — see worker/worker.js)
# Example: https://haven-hunt-relay.your-subdomain.workers.dev
WEB_RELAY_URL=

# Public site URL (GitHub Pages)
SITE_URL=https://YOUR_USERNAME.github.io/haven-hunt/
